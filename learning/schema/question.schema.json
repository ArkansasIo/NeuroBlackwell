{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroBlackwell Assessment Question",
  "type": "object",
  "required": [
    "id",
    "level",
    "subject",
    "domain",
    "skill",
    "difficulty",
    "prompt",
    "answer",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "kindergarten",
        "elementary",
        "middle_school",
        "high_school",
        "college",
        "university",
        "graduate_research"
      ]
    },
    "subject": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "cognitive_operation": {
      "type": "string"
    },
    "prerequisite_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": "string"
    },
    "answer": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "enum": [
        "synthetic",
        "research_derived",
        "licensed_or_user_supplied"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}